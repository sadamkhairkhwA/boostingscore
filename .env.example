# Copy to .env and fill in values. Never commit .env.

# Required in production; optional locally (Django has a dev default).
# SECRET_KEY=

# Set to false in production.
# DEBUG=true

# Comma-separated hostnames (no scheme/path).
# ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# ALLOWED_HOSTS=boostingscore.com,www.boostingscore.com,web-production-9b744.up.railway.app

# Comma-separated trusted origins for CSRF (scheme + host, no path).
# CSRF_TRUSTED_ORIGINS=https://boostingscore.com,https://www.boostingscore.com,https://boostingscore-production.up.railway.app

# Database.
# Local: leave DATABASE_URL unset to use SQLite (db.sqlite3).
# Railway: MUST set DATABASE_URL to the Postgres plugin reference, e.g.:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# (Railway dashboard → web service → Variables → Add variable reference.)
# Never point production at SQLite — the container filesystem is ephemeral
# and every redeploy wipes user accounts.
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Optional connection pool lifetime in seconds (PostgreSQL only).
# DB_CONN_MAX_AGE=60

# OpenAI API key for populate_words, populate_passages, populate_questions, and essay grading.
# OPENAI_API_KEY=sk-...
#
# If billing is on a specific org/project, set these (from dashboard URLs / settings).
# OPENAI_ORGANIZATION=org-...
# OPENAI_PROJECT=proj_...
#
# Optional: override model (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini
#
# Long passage generation may need a higher HTTP timeout (seconds).
# OPENAI_TIMEOUT=300
#
# Optional: custom API base (default https://api.openai.com/v1).
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Vocabulary “AI illustration” (OpenAI Images). Uses the same OPENAI_API_KEY; billed separately from chat.
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_QUALITY=standard
# OPENAI_IMAGE_TIMEOUT=120

# Public base URL for large media (speaking_tips, speaking_videos*, listening_audio).
# Leave unset locally so files are served from /static/. On Railway, set to your
# Cloudflare R2 public URL with no trailing slash, e.g.:
# MEDIA_CDN_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# Email (signup verification, profile email change, password reset).
# Local default is console backend (link prints in runserver logs) — leave
# RESEND_API_KEY unset locally to avoid hitting the real API.
#
# Railway Free / Trial / Hobby blocks outbound SMTP (ports 25, 465, 587).
# Use Resend's HTTPS API (port 443). RESEND_API_KEY takes priority even if an
# old EMAIL_BACKEND=smtp.* variable is still set:
#   RESEND_API_KEY=re_xxxxxxxx
#   DEFAULT_FROM_EMAIL=BoostingScore <noreply@your-verified-domain.com>
# Remove EMAIL_BACKEND / EMAIL_HOST / EMAIL_HOST_PASSWORD if they point at SMTP.
